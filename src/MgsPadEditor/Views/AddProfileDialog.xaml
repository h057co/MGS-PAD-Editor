<Window x:Class="MgsPadEditor.Views.AddProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuevo Perfil de Mando" Height="280" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BrushBgMain}" Foreground="{StaticResource BrushTextWhite}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#000000" BorderBrush="{StaticResource BrushAccentCyan}" BorderThickness="1" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,6">
            <TextBlock Text="NOMBRE DEL PERFIL (SIN ESPACIOS, EJ: MI_MANDO_XBOX)" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" FontSize="10" Foreground="{StaticResource BrushAccentCyan}"/>
        </Border>
        <TextBox x:Name="TxtName" Grid.Row="1" Height="30" Background="#0A0C12" Foreground="#FFFFFF" BorderBrush="#000000" BorderThickness="2" Padding="6,2" VerticalContentAlignment="Center" FontFamily="{StaticResource MonoFont}"/>

        <Border Grid.Row="2" Background="#000000" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" Padding="6,2" HorizontalAlignment="Left" Margin="0,14,0,6">
            <TextBlock Text="GUID DIRECTINPUT (OPCIONAL, OBTENIDO DEL MANDO)" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" FontSize="10" Foreground="{StaticResource BrushTextMuted}"/>
        </Border>
        <TextBox x:Name="TxtGuid" Grid.Row="3" Height="30" Background="#0A0C12" Foreground="{StaticResource BrushAccentCyan}" BorderBrush="#000000" BorderThickness="2" Padding="6,2" VerticalContentAlignment="Center" FontFamily="{StaticResource MonoFont}" FontWeight="Bold"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="ACEPTAR" Width="100" Height="32" Click="BtnOk_Click" Style="{StaticResource BtnGreen}" Margin="0,0,10,0"/>
            <Button Content="CANCELAR" Width="100" Height="32" Click="BtnCancel_Click" Style="{StaticResource BtnDark}"/>
        </StackPanel>
    </Grid>
</Window>