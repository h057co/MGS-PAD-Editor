<Window x:Class="MgsPadEditor.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acerca de MGS PAD Editor" Height="620" Width="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BrushBgMain}" Foreground="{StaticResource BrushTextWhite}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Header Tactical Bar -->
            <RowDefinition Height="*"/>    <!-- 1: Main Content Container -->
            <RowDefinition Height="Auto"/> <!-- 2: Bottom Actions -->
        </Grid.RowDefinitions>

        <!-- ROW 0: Tactical Header Bar -->
        <Border Grid.Row="0" Background="#000000" BorderBrush="{StaticResource BrushAccentCyan}" BorderThickness="2" Padding="10,6" Margin="0,0,0,14">
            <DockPanel>
                <TextBlock Text="●" Foreground="{StaticResource BrushAccentGreen}" FontWeight="Black" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="// IDENTIFICACIÓN DE SISTEMA // ACERCA DE" FontSize="11" FontWeight="Black" Foreground="#FFFFFF" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"/>
                <TextBlock Text="MGS-INFO-01" FontSize="10" Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource MonoFont}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ROW 1: Main Brutalist Card -->
        <Border Grid.Row="1" Style="{StaticResource BrutalistCard}" Padding="20,16" Margin="0,0,0,14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- App Title & Version Badges -->
                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                        <TextBlock Text="MGS PAD EDITOR" FontSize="26" FontWeight="Black" FontFamily="{StaticResource MonoFont}" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <Border DockPanel.Dock="Right" Background="#000000" BorderBrush="{StaticResource BrushAccentGreen}" BorderThickness="1" Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v2.0 TACTICAL" FontSize="11" FontWeight="Black" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource BrushAccentGreen}"/>
                        </Border>
                    </DockPanel>

                    <!-- Tagline -->
                    <Border Background="#000000" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" Padding="8,4" Margin="0,0,0,14">
                        <TextBlock Text="CONFIGURADOR TÁCTICO DE MANDOS PARA METAL GEAR SOLID 1 (PC / GOG)"
                                   FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushAccentCyan}"/>
                    </Border>

                    <!-- Author & Credits Card -->
                    <Border Background="#0E1017" BorderBrush="#000000" BorderThickness="2" Padding="14,10" Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Author -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="AUTORÍA:" FontFamily="{StaticResource MonoFont}" FontWeight="Black" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,2"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Luis Jimenez" FontFamily="{StaticResource MonoFont}" FontWeight="Black" FontSize="13" Foreground="#FFFFFF"/>
                                <TextBlock Text=" Aka " FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource BrushAccentYellow}"/>
                                <Border Background="#000000" BorderBrush="{StaticResource BrushAccentYellow}" BorderThickness="1" Padding="5,1">
                                    <TextBlock Text="'Hostility'" FontFamily="{StaticResource MonoFont}" FontWeight="Black" FontSize="12" Foreground="{StaticResource BrushAccentYellow}"/>
                                </Border>
                            </StackPanel>

                            <!-- License -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="LICENCIA:" FontFamily="{StaticResource MonoFont}" FontWeight="Black" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,6,0,2"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,2">
                                <Border Background="#000000" BorderBrush="{StaticResource BrushAccentGreen}" BorderThickness="1" Padding="6,1" Margin="0,0,8,0">
                                    <TextBlock Text="MIT LICENSE" FontFamily="{StaticResource MonoFont}" FontWeight="Black" FontSize="10" Foreground="{StaticResource BrushAccentGreen}"/>
                                </Border>
                                <TextBlock Text="Software Libre, Gratuito y de Código Abierto" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Repository / GitHub -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="GITHUB:" FontFamily="{StaticResource MonoFont}" FontWeight="Black" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,6,0,2"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,2">
                                <Button Content="🌐 github.com/h057co" Click="BtnGitHub_Click" Style="{StaticResource BtnDark}" Height="24" Padding="8,1" FontSize="11" Margin="0,0,8,0"/>
                                <Button Content="COPIAR LINK" Click="BtnCopyLink_Click" Style="{StaticResource BtnCyan}" Height="24" Padding="8,1" FontSize="10"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Features & Architecture Section -->
                    <Border Background="#000000" BorderBrush="{StaticResource BrushAccentYellow}" BorderThickness="1" Padding="6,2" Margin="0,0,0,8" HorizontalAlignment="Left">
                        <TextBlock Text="// CAPACIDADES DEL SISTEMA" FontFamily="{StaticResource MonoFont}" FontWeight="Black" FontSize="10" Foreground="{StaticResource BrushAccentYellow}"/>
                    </Border>

                    <Border Background="#11141D" BorderBrush="#000000" BorderThickness="2" Padding="12,10" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="🎮 Vista Visual Interactiva DualSense (PS5): Mapeo ergonómico completo 1:1." FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource BrushTextPrimary}" Margin="0,2"/>
                            <TextBlock Text="🎯 Telemetría en Vivo: Osciloscopio XY para sticks analógicos y radar de gatillos." FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource BrushTextPrimary}" Margin="0,2"/>
                            <TextBlock Text="🛠 Reparación Hexadecimal de mgs.cfg: Sincroniza y elimina conflictos con dixi.ini." FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource BrushTextPrimary}" Margin="0,2"/>
                            <TextBlock Text="⚡ Auto-Emparejamiento: Detección automática por GUID DirectInput y presets PS1." FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource BrushTextPrimary}" Margin="0,2"/>
                            <TextBlock Text="⌨ Emulación Avanzada: Soporte simultáneo para Teclado, Ratón y Gamepads." FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource BrushTextPrimary}" Margin="0,2"/>
                        </StackPanel>
                    </Border>

                    <!-- Disclaimer & Dedication -->
                    <Border Background="#090A0E" BorderBrush="#1D212E" BorderThickness="1" Padding="10,6">
                        <TextBlock Text="Dedicado a la comunidad de Metal Gear Solid y a la preservación de los clásicos en PC. Metal Gear Solid es marca registrada de Konami Digital Entertainment."
                                   FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ROW 2: Bottom Command Bar -->
        <DockPanel Grid.Row="2" LastChildFill="False">
            <Button Content="🌐 VER PERFIL EN GITHUB" Click="BtnGitHub_Click" Style="{StaticResource BtnCyan}" Height="32" Width="190" DockPanel.Dock="Left"/>
            <Button Content="CERRAR // DISMISS" Click="BtnClose_Click" IsCancel="True" IsDefault="True" Style="{StaticResource BtnGreen}" Height="32" Width="150" DockPanel.Dock="Right"/>
        </DockPanel>
    </Grid>
</Window>

