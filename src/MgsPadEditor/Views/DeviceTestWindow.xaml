<Window x:Class="MgsPadEditor.Views.DeviceTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Probador de Mando en Vivo (Telemetry)" Height="620" Width="780"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBgMain}" Foreground="{StaticResource BrushTextWhite}"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Oscilloscope & Sensors -->
            <RowDefinition Height="130"/>  <!-- Tactical Terminal Log -->
            <RowDefinition Height="Auto"/> <!-- Close Button -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#000000" BorderBrush="{StaticResource BrushAccentCyan}" BorderThickness="2" Padding="10,6" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock Text="●" Foreground="{StaticResource BrushAccentGreen}" FontWeight="Black" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtDeviceName" Text="TELEMETRÍA DE MANDO // EN VIVO" FontSize="12" FontWeight="Black" Foreground="#FFFFFF" FontFamily="{StaticResource MonoFont}"/>
            </DockPanel>
        </Border>

        <!-- Visual Controller Monitors -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Sticks & Triggers -->
            <Border Grid.Column="0" Background="{StaticResource BrushBgCard}" BorderBrush="#000000" BorderThickness="2" Padding="12" Margin="0,0,6,0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="0" ShadowDepth="4" Direction="315" Opacity="0.95"/>
                </Border.Effect>
                <StackPanel>
                    <Border Background="#000000" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" Padding="6,2" Margin="0,0,0,8">
                        <TextBlock Text="// STICKS ANALÓGICOS (RADAR SCOPE)" FontWeight="Black" Foreground="{StaticResource BrushAccentCyan}" FontFamily="{StaticResource MonoFont}" FontSize="10"/>
                    </Border>
                    
                    <Grid Height="125">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Stick Plot -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="STICK L (IZQUIERDO)" FontSize="10" FontWeight="Black" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <Border Width="90" Height="90" Background="#090A0E" BorderBrush="#000000" BorderThickness="2">
                                <Canvas Width="90" Height="90" ClipToBounds="True">
                                    <!-- Crosshairs -->
                                    <Line X1="0" Y1="45" X2="90" Y2="45" Stroke="#1D2333" StrokeThickness="1"/>
                                    <Line X1="45" Y1="0" X2="45" Y2="90" Stroke="#1D2333" StrokeThickness="1"/>
                                    <!-- Indicator -->
                                    <Border x:Name="DotLeftStick" Width="14" Height="14" Background="{StaticResource BrushAccentCyan}" BorderBrush="#000000" BorderThickness="2" Canvas.Left="38" Canvas.Top="38"/>
                                </Canvas>
                            </Border>
                            <TextBlock x:Name="TxtLeftStickCoords" Text="X: +0.00 | Y: +0.00" FontSize="10" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" Foreground="{StaticResource BrushAccentCyan}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Right Stick Plot -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="STICK R (DERECHO)" FontSize="10" FontWeight="Black" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <Border Width="90" Height="90" Background="#090A0E" BorderBrush="#000000" BorderThickness="2">
                                <Canvas Width="90" Height="90" ClipToBounds="True">
                                    <!-- Crosshairs -->
                                    <Line X1="0" Y1="45" X2="90" Y2="45" Stroke="#1D2333" StrokeThickness="1"/>
                                    <Line X1="45" Y1="0" X2="45" Y2="90" Stroke="#1D2333" StrokeThickness="1"/>
                                    <!-- Indicator -->
                                    <Border x:Name="DotRightStick" Width="14" Height="14" Background="{StaticResource BrushAccentCyan}" BorderBrush="#000000" BorderThickness="2" Canvas.Left="38" Canvas.Top="38"/>
                                </Canvas>
                            </Border>
                            <TextBlock x:Name="TxtRightStickCoords" Text="X: +0.00 | Y: +0.00" FontSize="10" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" Foreground="{StaticResource BrushAccentCyan}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Separator Background="#000000" Margin="0,10,0,8"/>

                    <!-- Triggers -->
                    <Border Background="#000000" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" Padding="6,2" Margin="0,0,0,8">
                        <TextBlock Text="// GATILLOS (L2 / R2 ANALÓGICOS &amp; DIGITALES)" FontSize="10" FontWeight="Black" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource BrushAccentYellow}"/>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock x:Name="TxtLeftTrigger" Text="L2 (GATILLO IZQ): 0%" FontSize="10" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                            <ProgressBar x:Name="PbLeftTrigger" Height="12" Minimum="0" Maximum="1" Value="0" Background="#090A0E" Foreground="{StaticResource BrushAccentGreen}" BorderBrush="#000000" BorderThickness="2" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock x:Name="TxtRightTrigger" Text="R2 (GATILLO DER): 0%" FontSize="10" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                            <ProgressBar x:Name="PbRightTrigger" Height="12" Minimum="0" Maximum="1" Value="0" Background="#090A0E" Foreground="{StaticResource BrushAccentGreen}" BorderBrush="#000000" BorderThickness="2" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Right: D-Pad, Buttons Matrix, and Raw Telemetry -->
            <Border Grid.Column="1" Background="{StaticResource BrushBgCard}" BorderBrush="#000000" BorderThickness="2" Padding="12" Margin="6,0,0,0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="0" ShadowDepth="4" Direction="315" Opacity="0.95"/>
                </Border.Effect>
                <StackPanel>
                    <!-- D-Pad Display -->
                    <Border Background="#090A0E" BorderBrush="#000000" BorderThickness="2" Padding="8,3" Margin="0,0,0,8">
                        <TextBlock x:Name="TxtDpad" Text="CRUCETA: NEUTRAL" FontSize="11" FontWeight="Black" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource BrushAccentCyan}"/>
                    </Border>

                    <!-- Buttons Matrix -->
                    <TextBlock Text="MATRIZ DE BOTONES (0:□ 1:✕ 2:○ 3:△ 4:L1 5:R1 6:L2 7:R2):" FontSize="9" FontWeight="Black" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,4"/>
                    <WrapPanel x:Name="ButtonsPanel" Margin="0,0,0,8">
                        <!-- Badges 0 through 15 created dynamically in code -->
                    </WrapPanel>

                    <Separator Background="#000000" Margin="0,0,0,8"/>

                    <!-- Raw DirectInput Diagnostics -->
                    <Border Background="#000000" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" Padding="6,2" Margin="0,0,0,6">
                        <TextBlock Text="// TELEMETRÍA RAW DIRECTINPUT (ESTADO FÍSICO DE LOS 6 EJES)" FontWeight="Black" Foreground="{StaticResource BrushAccentYellow}" FontFamily="{StaticResource MonoFont}" FontSize="9"/>
                    </Border>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TxtRawX" Grid.Row="0" Grid.Column="0" Text="X: 32768" FontSize="10" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource BrushTextSecondary}" Margin="2"/>
                        <TextBlock x:Name="TxtRawY" Grid.Row="0" Grid.Column="1" Text="Y: 32768" FontSize="10" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource BrushTextSecondary}" Margin="2"/>
                        <TextBlock x:Name="TxtRawZ" Grid.Row="0" Grid.Column="2" Text="Z: 32768" FontSize="10" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource BrushTextSecondary}" Margin="2"/>
                        <TextBlock x:Name="TxtRawRx" Grid.Row="1" Grid.Column="0" Text="Rx: 0" FontSize="10" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource BrushAccentGreen}" Margin="2"/>
                        <TextBlock x:Name="TxtRawRy" Grid.Row="1" Grid.Column="1" Text="Ry: 0" FontSize="10" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource BrushAccentGreen}" Margin="2"/>
                        <TextBlock x:Name="TxtRawRz" Grid.Row="1" Grid.Column="2" Text="Rz: 32768" FontSize="10" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource BrushTextSecondary}" Margin="2"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Log Box (CRT Phosphor Terminal) -->
        <Border Grid.Row="2" Background="#06070A" BorderBrush="#000000" BorderThickness="2" Padding="8">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="0" ShadowDepth="3" Direction="315" Opacity="0.95"/>
            </Border.Effect>
            <TextBox x:Name="TxtLog" Background="Transparent" Foreground="{StaticResource BrushAccentGreen}" BorderThickness="0" FontFamily="{StaticResource MonoFont}" FontSize="11" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
        </Border>

        <!-- Footer -->
        <Button Grid.Row="3" Content="CERRAR MONITOR" Width="140" Height="32" Click="BtnClose_Click" HorizontalAlignment="Right" Style="{StaticResource BtnDark}" Margin="0,10,0,0"/>
    </Grid>
</Window>