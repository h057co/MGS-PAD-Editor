<Application x:Class="MgsPadEditor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Digital Brutalism Typography & Fonts -->
        <FontFamily x:Key="AppFont">Segoe UI, -apple-system, Arial, sans-serif</FontFamily>
        <FontFamily x:Key="MonoFont">Consolas, 'Courier New', monospace</FontFamily>

        <!-- Digital Brutalism / MGS Tactical Color Palette -->
        <Color x:Key="ColorBgMain">#090A0E</Color>
        <Color x:Key="ColorBgPanel">#10121A</Color>
        <Color x:Key="ColorBgCard">#161922</Color>
        <Color x:Key="ColorBgCardAlt">#1E2230</Color>
        <Color x:Key="ColorBorderBlack">#000000</Color>
        <Color x:Key="ColorBorderSubtle">#262B3A</Color>
        <Color x:Key="ColorBorderGrid">#1D212E</Color>

        <!-- Vivid Brutalist Accents -->
        <Color x:Key="ColorAccentGreen">#00FF66</Color>   <!-- MGS Codec Green -->
        <Color x:Key="ColorAccentCyan">#00F0FF</Color>    <!-- Cyber / Soliton Cyan -->
        <Color x:Key="ColorAccentYellow">#FFE600</Color>  <!-- Caution Yellow -->
        <Color x:Key="ColorAccentRed">#FF2A4D</Color>     <!-- Alert Red -->
        <Color x:Key="ColorAccentPink">#FF2E93</Color>    <!-- Square Pink -->
        <Color x:Key="ColorAccentBlue">#2979FF</Color>    <!-- Cross Blue -->

        <!-- Solid Brushes -->
        <SolidColorBrush x:Key="BrushBgMain" Color="{StaticResource ColorBgMain}"/>
        <SolidColorBrush x:Key="BrushBgPanel" Color="{StaticResource ColorBgPanel}"/>
        <SolidColorBrush x:Key="BrushBgCard" Color="{StaticResource ColorBgCard}"/>
        <SolidColorBrush x:Key="BrushBgCardAlt" Color="{StaticResource ColorBgCardAlt}"/>
        <SolidColorBrush x:Key="BrushBorderBlack" Color="{StaticResource ColorBorderBlack}"/>
        <SolidColorBrush x:Key="BrushBorderSubtle" Color="{StaticResource ColorBorderSubtle}"/>
        <SolidColorBrush x:Key="BrushBorderGrid" Color="{StaticResource ColorBorderGrid}"/>

        <SolidColorBrush x:Key="BrushAccentGreen" Color="{StaticResource ColorAccentGreen}"/>
        <SolidColorBrush x:Key="BrushAccentCyan" Color="{StaticResource ColorAccentCyan}"/>
        <SolidColorBrush x:Key="BrushAccentYellow" Color="{StaticResource ColorAccentYellow}"/>
        <SolidColorBrush x:Key="BrushAccentRed" Color="{StaticResource ColorAccentRed}"/>
        <SolidColorBrush x:Key="BrushAccentPink" Color="{StaticResource ColorAccentPink}"/>
        <SolidColorBrush x:Key="BrushAccentBlue" Color="{StaticResource ColorAccentBlue}"/>

        <SolidColorBrush x:Key="BrushTextWhite" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushTextPrimary" Color="#F2F5F8"/>
        <SolidColorBrush x:Key="BrushTextSecondary" Color="#9AA5B8"/>
        <SolidColorBrush x:Key="BrushTextMuted" Color="#5A6478"/>

        <!-- Base Window Font -->
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        </Style>

        <!-- Base Digital Brutalist Button (Hard offset black shadow, 2px border, tactile press) -->
        <Style x:Key="BrutalistButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#1E2330"/>
            <Setter Property="BorderBrush" Value="#000000"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Hard Brutalist Shadow Box -->
                            <Border x:Name="ShadowBox"
                                    Background="#000000"
                                    Margin="3,3,0,0"/>
                            <!-- Button Face -->
                            <Border x:Name="ButtonFace"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Margin="0,0,3,3"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonFace" Property="BorderBrush" Value="{StaticResource BrushAccentCyan}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonFace" Property="Margin" Value="2,2,1,1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonFace" Property="Opacity" Value="0.45"/>
                                <Setter TargetName="ShadowBox" Property="Opacity" Value="0.2"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Green Brutalist Button (Primary Action / PS1 Profile / Save) -->
        <Style x:Key="BtnGreen" TargetType="Button" BasedOn="{StaticResource BrutalistButtonStyle}">
            <Setter Property="Background" Value="{StaticResource BrushAccentGreen}"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#000000"/>
        </Style>

        <!-- Cyan Brutalist Button (Select / Focus) -->
        <Style x:Key="BtnCyan" TargetType="Button" BasedOn="{StaticResource BrutalistButtonStyle}">
            <Setter Property="Background" Value="{StaticResource BrushAccentCyan}"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#000000"/>
        </Style>

        <!-- Yellow Brutalist Button (Warning / Caution) -->
        <Style x:Key="BtnYellow" TargetType="Button" BasedOn="{StaticResource BrutalistButtonStyle}">
            <Setter Property="Background" Value="{StaticResource BrushAccentYellow}"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#000000"/>
        </Style>

        <!-- Red Brutalist Button (Delete / Danger) -->
        <Style x:Key="BtnRed" TargetType="Button" BasedOn="{StaticResource BrutalistButtonStyle}">
            <Setter Property="Background" Value="{StaticResource BrushAccentRed}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#000000"/>
        </Style>

        <!-- Dark Neutral Brutalist Button -->
        <Style x:Key="BtnDark" TargetType="Button" BasedOn="{StaticResource BrutalistButtonStyle}">
            <Setter Property="Background" Value="#222736"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#000000"/>
        </Style>

        <!-- Default Button also adopts the Brutalist style -->
        <Style TargetType="Button" BasedOn="{StaticResource BrutalistButtonStyle}"/>

        <!-- Digital Brutalist Card Container -->
        <Style x:Key="BrutalistCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushBgCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderBlack}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="0" ShadowDepth="4" Direction="315" Opacity="0.95"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Digital Brutalist Monospace Badge -->
        <Style x:Key="BrutalistBadge" TargetType="Border">
            <Setter Property="Background" Value="#000000"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushAccentCyan}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>

        <!-- Brutalist TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#11141D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#000000"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="CaretBrush" Value="{StaticResource BrushAccentGreen}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource BrushAccentGreen}"/>
            <Setter Property="SelectionOpacity" Value="0.4"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BrushAccentCyan}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox ToggleButton ControlTemplate -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Grid SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="26"/>
                </Grid.ColumnDefinitions>

                <!-- Brutalist Toggle Button Face -->
                <Border x:Name="ButtonBody" Grid.ColumnSpan="2"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"/>

                <!-- Dropdown Chevron Badge -->
                <Border x:Name="ArrowBox" Grid.Column="1"
                        Background="#161922"
                        BorderBrush="#000000"
                        BorderThickness="2,0,0,0">
                    <Path x:Name="Arrow"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Fill="{StaticResource BrushAccentCyan}"
                          Data="M 0 0 L 8 0 L 4 5 Z"/>
                </Border>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ButtonBody" Property="Background" Value="#1A1F2C"/>
                    <Setter TargetName="ButtonBody" Property="BorderBrush" Value="{StaticResource BrushAccentCyan}"/>
                    <Setter TargetName="ArrowBox" Property="Background" Value="#222736"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource BrushAccentGreen}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="ButtonBody" Property="Background" Value="#1A1F2C"/>
                    <Setter TargetName="ButtonBody" Property="BorderBrush" Value="{StaticResource BrushAccentCyan}"/>
                    <Setter TargetName="ArrowBox" Property="Background" Value="{StaticResource BrushAccentCyan}"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#000000"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="ButtonBody" Property="Opacity" Value="0.45"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource BrushTextMuted}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Digital Brutalist ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#10121A"/>
            <Setter Property="BorderBrush" Value="#000000"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="MaxDropDownHeight" Value="320"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid" SnapsToDevicePixels="True">
                            <!-- Brutalist Dropdown Toggle Button -->
                            <ToggleButton x:Name="DropDownToggle"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}"/>

                            <!-- Current Selection Display -->
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,0,28,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>

                            <!-- Dropdown Popup Container -->
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      MinWidth="{Binding ActualWidth, ElementName=MainGrid}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                      SnapsToDevicePixels="True">
                                    <!-- Hard Black Brutalist Drop Shadow -->
                                    <Border Background="#000000" Margin="3,3,0,0"/>

                                    <!-- Dropdown Menu Frame -->
                                    <Border x:Name="DropDownBorder"
                                            Background="#0C0E15"
                                            BorderBrush="{StaticResource BrushAccentCyan}"
                                            BorderThickness="2"
                                            Margin="0,0,3,3">
                                        <ScrollViewer CanContentScroll="True" SnapsToDevicePixels="True">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"
                                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="32"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DropDownToggle" Property="BorderBrush" Value="{StaticResource BrushAccentCyan}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="DropDownToggle" Property="BorderBrush" Value="{StaticResource BrushAccentCyan}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Digital Brutalist ComboBoxItem Style (High Contrast) -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Foreground" Value="#F2F5F8"/>
            <Setter Property="Background" Value="#0C0E15"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#1D212E"
                                BorderThickness="0,0,0,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Mouse Hover: Neon Codec Green + Black Bold Text -->
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource BrushAccentGreen}"/>
                                <Setter Property="Foreground" Value="#000000"/>
                                <Setter Property="TextElement.Foreground" Value="#000000"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="TextElement.FontWeight" Value="Bold"/>
                            </Trigger>

                            <!-- Selected Item: Neon Soliton Cyan + Black Bold/Black Text -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource BrushAccentCyan}"/>
                                <Setter Property="Foreground" Value="#000000"/>
                                <Setter Property="TextElement.Foreground" Value="#000000"/>
                                <Setter Property="FontWeight" Value="Black"/>
                                <Setter Property="TextElement.FontWeight" Value="Black"/>
                            </Trigger>

                            <!-- Both Selected and Hovered: Caution Yellow + Black Text -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsHighlighted" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource BrushAccentYellow}"/>
                                <Setter Property="Foreground" Value="#000000"/>
                                <Setter Property="TextElement.Foreground" Value="#000000"/>
                                <Setter Property="FontWeight" Value="Black"/>
                                <Setter Property="TextElement.FontWeight" Value="Black"/>
                            </MultiTrigger>

                            <!-- Disabled Item -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
                                <Setter Property="TextElement.Foreground" Value="{StaticResource BrushTextMuted}"/>
                                <Setter TargetName="ItemBorder" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Digital Brutalist ScrollBar Styles -->
        <Style x:Key="BrutalistScrollThumb" TargetType="Thumb">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Background="#262D3D"
                                BorderBrush="#000000"
                                BorderThickness="1"
                                CornerRadius="0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource BrushAccentCyan}"/>
                                <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="#000000"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource BrushAccentGreen}"/>
                                <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="#000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="#0A0C12">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource BrutalistScrollThumb}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="#0A0C12">
                                    <Track x:Name="PART_Track">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource BrutalistScrollThumb}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Digital Brutalist Menu & MenuItem Styles -->
        <ControlTemplate x:Key="TopLevelHeaderTemplate" TargetType="MenuItem">
            <Grid SnapsToDevicePixels="True">
                <Border x:Name="HeaderBorder"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="2"
                        Padding="10,5"
                        Margin="1,0">
                    <ContentPresenter ContentSource="Header"
                                      RecognizesAccessKey="True"
                                      VerticalAlignment="Center"/>
                </Border>

                <Popup x:Name="PART_Popup"
                       AllowsTransparency="True"
                       Focusable="False"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                       Placement="Bottom"
                       PopupAnimation="Slide">
                    <Grid SnapsToDevicePixels="True">
                        <!-- Hard Brutalist Drop Shadow -->
                        <Border Background="#000000" Margin="4,4,0,0"/>

                        <!-- Menu Dropdown Box -->
                        <Border x:Name="SubmenuBorder"
                                Background="#0A0C12"
                                BorderBrush="{StaticResource BrushAccentCyan}"
                                BorderThickness="2"
                                Padding="2"
                                Margin="0,0,4,4"
                                Grid.IsSharedSizeScope="True">
                            <ScrollViewer CanContentScroll="True" SnapsToDevicePixels="True">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="HeaderBorder" Property="Background" Value="#171B26"/>
                    <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{StaticResource BrushAccentCyan}"/>
                    <Setter Property="Foreground" Value="{StaticResource BrushAccentCyan}"/>
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="HeaderBorder" Property="Background" Value="#1A2030"/>
                    <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{StaticResource BrushAccentGreen}"/>
                    <Setter Property="Foreground" Value="{StaticResource BrushAccentGreen}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="TopLevelItemTemplate" TargetType="MenuItem">
            <Border x:Name="HeaderBorder"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="2"
                    Padding="10,5"
                    Margin="1,0"
                    SnapsToDevicePixels="True"
                    Cursor="Hand">
                <ContentPresenter ContentSource="Header"
                                  RecognizesAccessKey="True"
                                  VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="HeaderBorder" Property="Background" Value="#171B26"/>
                    <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{StaticResource BrushAccentCyan}"/>
                    <Setter Property="Foreground" Value="{StaticResource BrushAccentCyan}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="SubmenuItemTemplate" TargetType="MenuItem">
            <Border x:Name="ItemBorder"
                    Background="#0A0C12"
                    BorderBrush="#171B26"
                    BorderThickness="0,0,0,1"
                    Padding="12,6"
                    SnapsToDevicePixels="True"
                    Cursor="Hand">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="MenuIconCol"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGestureCol"/>
                    </Grid.ColumnDefinitions>

                    <ContentPresenter x:Name="IconHost"
                                      ContentSource="Icon"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center"/>

                    <ContentPresenter x:Name="HeaderHost"
                                      Grid.Column="1"
                                      ContentSource="Header"
                                      RecognizesAccessKey="True"
                                      VerticalAlignment="Center"/>

                    <TextBlock x:Name="GestureText"
                               Grid.Column="2"
                               Text="{TemplateBinding InputGestureText}"
                               Margin="24,0,4,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="10"
                               Foreground="{StaticResource BrushTextMuted}"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="Icon" Value="{x:Null}">
                    <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="InputGestureText" Value="">
                    <Setter TargetName="GestureText" Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource BrushAccentGreen}"/>
                    <Setter Property="Foreground" Value="#000000"/>
                    <Setter Property="TextElement.Foreground" Value="#000000"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="TextElement.FontWeight" Value="Bold"/>
                    <Setter TargetName="GestureText" Property="Foreground" Value="#000000"/>
                    <Setter TargetName="GestureText" Property="FontWeight" Value="Bold"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
                    <Setter Property="TextElement.Foreground" Value="{StaticResource BrushTextMuted}"/>
                    <Setter TargetName="ItemBorder" Property="Opacity" Value="0.4"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="SubmenuHeaderTemplate" TargetType="MenuItem">
            <Grid SnapsToDevicePixels="True">
                <Border x:Name="ItemBorder"
                        Background="#0A0C12"
                        BorderBrush="#171B26"
                        BorderThickness="0,0,0,1"
                        Padding="12,6"
                        Cursor="Hand">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="MenuIconCol"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ContentPresenter x:Name="IconHost"
                                          ContentSource="Icon"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center"/>

                        <ContentPresenter x:Name="HeaderHost"
                                          Grid.Column="1"
                                          ContentSource="Header"
                                          RecognizesAccessKey="True"
                                          VerticalAlignment="Center"/>

                        <TextBlock x:Name="Arrow"
                                   Grid.Column="2"
                                   Text="▶"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="9"
                                   Foreground="{StaticResource BrushAccentCyan}"/>
                    </Grid>
                </Border>

                <Popup x:Name="PART_Popup"
                       AllowsTransparency="True"
                       Focusable="False"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                       Placement="Right"
                       PopupAnimation="Slide">
                    <Grid SnapsToDevicePixels="True">
                        <Border Background="#000000" Margin="4,4,0,0"/>
                        <Border Background="#0A0C12"
                                BorderBrush="{StaticResource BrushAccentCyan}"
                                BorderThickness="2"
                                Padding="2"
                                Margin="0,0,4,4"
                                Grid.IsSharedSizeScope="True">
                            <ScrollViewer CanContentScroll="True" SnapsToDevicePixels="True">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="Icon" Value="{x:Null}">
                    <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource BrushAccentGreen}"/>
                    <Setter Property="Foreground" Value="#000000"/>
                    <Setter Property="TextElement.Foreground" Value="#000000"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="TextElement.FontWeight" Value="Bold"/>
                    <Setter TargetName="Arrow" Property="Foreground" Value="#000000"/>
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource BrushAccentCyan}"/>
                    <Setter Property="Foreground" Value="#000000"/>
                    <Setter Property="TextElement.Foreground" Value="#000000"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="TextElement.FontWeight" Value="Bold"/>
                    <Setter TargetName="Arrow" Property="Foreground" Value="#000000"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
                    <Setter Property="TextElement.Foreground" Value="{StaticResource BrushTextMuted}"/>
                    <Setter TargetName="ItemBorder" Property="Opacity" Value="0.4"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="Menu">
            <Setter Property="Background" Value="#0A0C12"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Style.Triggers>
                <Trigger Property="Role" Value="TopLevelHeader">
                    <Setter Property="Template" Value="{StaticResource TopLevelHeaderTemplate}"/>
                </Trigger>
                <Trigger Property="Role" Value="TopLevelItem">
                    <Setter Property="Template" Value="{StaticResource TopLevelItemTemplate}"/>
                </Trigger>
                <Trigger Property="Role" Value="SubmenuItem">
                    <Setter Property="Template" Value="{StaticResource SubmenuItemTemplate}"/>
                </Trigger>
                <Trigger Property="Role" Value="SubmenuHeader">
                    <Setter Property="Template" Value="{StaticResource SubmenuHeaderTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Height" Value="2"/>
            <Setter Property="Background" Value="#1D212E"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="{TemplateBinding Height}"
                                Background="{TemplateBinding Background}"
                                Margin="{TemplateBinding Margin}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Digital Brutalist DataGridCell & DataGridRow Selection Styles -->
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#172B3C"/>
                    <Setter Property="Foreground" Value="{StaticResource BrushAccentCyan}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#131620"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1C212E"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#152636"/>
                    <Setter Property="Foreground" Value="{StaticResource BrushAccentCyan}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Brutalist CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Square Box Shadow -->
                            <Border Width="18" Height="18" Background="#000000" Margin="2,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <!-- Square Box Face -->
                            <Border x:Name="CheckBorder" Width="18" Height="18"
                                    Background="#161922" BorderBrush="#000000" BorderThickness="2"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock x:Name="CheckMark" Text="■" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource BrushAccentGreen}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="0,-3,0,0" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource BrushAccentGreen}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource BrushAccentCyan}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Brutalist Slider Style -->
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource BrushAccentGreen}"/>
            <Setter Property="Background" Value="#161922"/>
            <Setter Property="BorderBrush" Value="#000000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="24"/>
        </Style>
    </Application.Resources>
</Application>